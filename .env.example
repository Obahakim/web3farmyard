# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DeePn
NEXT_PUBLIC_APP_TAGLINE="Your Private Emotional Vault"

# Database
DATABASE_URL=postgresql://deepn:deepn@localhost:5432/deepn?schema=public

# Redis / Queue / Rate limiting
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=deepn

# Auth
BETTER_AUTH_SECRET=replace-with-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000
MAGIC_LINK_FROM_EMAIL=no-reply@deepn.local

# Email provider abstraction (dev logs emails to console)
EMAIL_PROVIDER=console
RESEND_API_KEY=

# Encryption
FIELD_ENCRYPTION_MASTER_KEY_BASE64=replace-with-32-byte-base64-key
LOCKED_VAULT_ARGON2_MEMORY_KIB=65536
LOCKED_VAULT_ARGON2_ITERATIONS=3
LOCKED_VAULT_ARGON2_PARALLELISM=1

# OpenAI / AI routing
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./local-storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=deepn-dev
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-password
S3_FORCE_PATH_STYLE=true

# Security
RATE_LIMIT_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
FEATURE_FLAGS_SOURCE=env
