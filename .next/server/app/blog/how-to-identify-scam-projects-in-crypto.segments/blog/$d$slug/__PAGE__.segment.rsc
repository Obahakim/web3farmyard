              border: 1px solid #ddd;
              padding: 0.75rem;
              text-align: left;
            }

            .blog-content th {
              background: #f5f5f5;
              font-weight: bold;
            }

            .blog-content img {
              max-width: 100%;
              height: auto;
              border-radius: 8px;
              margin: 1.5rem 0;
            }

            .blog-content hr {
              border: none;
              border-top: 2px solid #e0e0e0;
              margin: 2rem 0;
            }
