            .blog-content p {
              margin-bottom: 1.5rem;
              color: #333;
              line-height: 1.8;
            }
            
            .blog-content h2, .blog-content h3, .blog-content h4 {
              margin-top: 2rem;
              margin-bottom: 1rem;
              color: #0a0a0a;
              font-weight: bold;
            }

            .blog-content h2 {
              font-size: 1.75rem;
              border-bottom: 2px solid #1a6b00;
              padding-bottom: 0.5rem;
            }

            .blog-content h3 {
              font-size: 1.5rem;
            }

            .blog-content h4 {
              font-size: 1.25rem;
            }

            .blog-content ul, .blog-content ol {
              margin: 1.5rem 0;
              padding-left: 2rem;
            }

            .blog-content li {
              margin-bottom: 0.5rem;
              color: #333;
            }

            .blog-content blockquote {
              border-left: 4px solid #1a6b00;
              padding-left: 1rem;
              margin: 1.5rem 0;
              font-style: italic;
              color: #666;
            }

            .blog-content a {
              color: #1a6b00;
              text-decoration: underline;
              font-weight: 500;
            }

            .blog-content a:hover {
              color: #134f00;
            }

            .blog-content code {
              background: #f5f5f5;
              padding: 0.2rem 0.4rem;
              border-radius: 4px;
              font-family: 'Courier New', monospace;
              color: #d63384;
            }

            .blog-content pre {
              background: #f5f5f5;
              padding: 1rem;
              border-radius: 8px;
              overflow-x: auto;
              margin: 1.5rem 0;
            }

            .blog-content pre code {
              background: none;
              padding: 0;
              color: #0a0a0a;
            }

            .blog-content table {
              border-collapse: collapse;
              width: 100%;
              margin: 1.5rem 0;
              border: 1px solid #ddd;
            }

            .blog-content th, .blog-content td {
              border: 1px solid #ddd;
              padding: 0.75rem;
              text-align: left;
            }

            .blog-content th {
              background: #f5f5f5;
              font-weight: bold;
            }

            .blog-content img {
              max-width: 100%;
              height: auto;
              border-radius: 8px;
              margin: 1.5rem 0;
            }

            .blog-content hr {
              border: none;
              border-top: 2px solid #e0e0e0;
              margin: 2rem 0;
            }
