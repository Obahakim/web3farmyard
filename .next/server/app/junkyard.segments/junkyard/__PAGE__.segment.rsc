7:["$","main",null,{"className":"max-w-[1100px] mx-auto px-7","children":[["$","section",null,{"className":"py-12 animate-fadeUp","children":[["$","div",null,{"className":"font-mono text-[8px] tracking-[0.25em] mb-3 animate-flicker","style":{"color":"#cc0000"},"children":"☠️ THE JUNKYARD"}],["$","h1",null,{"className":"font-serif font-bold text-dark mb-4","style":{"fontSize":"clamp(32px,5vw,58px)","lineHeight":1.05,"letterSpacing":"-0.03em"},"children":["They promised moonshots.",["$","br",null,{}],["$","span",null,{"style":{"WebkitTextStroke":"1px #ff4d4d","color":"transparent"},"children":"They delivered dust."}]]}],["$","p",null,{"className":"text-[15px] max-w-xl mb-6","style":{"color":"#555","lineHeight":1.8},"children":"A permanent record of crypto's worst failures. Rugs, ponzis, exploits, abandoned projects and dead chains. Preserved so history doesn't have to repeat itself — though it probably will."}],["$","div",null,{"className":"glass p-4","style":{"background":"#0d0606","border":"none","borderLeft":"3px solid #ff4d4d"},"children":["$","p",null,{"className":"font-mono text-[10px]","style":{"color":"#5a2a2a","lineHeight":1.8},"children":["⚠ ",["$","strong",null,{"style":{"color":"#ff7a7a"},"children":"IMPORTANT:"}]," This page exists purely for historical record and education. None of these projects are listed as investments. If someone is trying to sell you a token from this list — run."]}]}]]}],["$","section",null,{"className":"glass p-5 mb-8","children":[["$","h2",null,{"className":"font-serif font-bold text-dark mb-2 text-lg","children":"The Crypto Graveyard"}],["$","p",null,{"className":"text-sm","style":{"color":"#555","lineHeight":1.8},"children":["Explore documented crypto failures including ",["$","strong",null,{"children":"rug pulls"}],", ",["$","strong",null,{"children":"Ponzi schemes"}],", ",["$","strong",null,{"children":"smart contract exploits"}],", and ",["$","strong",null,{"children":"collapsed ecosystems"}],". Each entry includes its cause of death, peak values, and lessons learned."]}]]}],["$","section",null,{"className":"grid gap-4 md:grid-cols-1 mb-8","children":["$","$Lc",null,{"href":"/blog/how-to-identify-scam-projects-in-crypto","className":"glass p-5 hover:bg-white/5 transition-all","style":{"borderLeft":"3px solid #ff4d4d"},"children":["$","div",null,{"className":"flex items-center justify-between","children":[["$","div",null,{"children":[["$","h3",null,{"className":"font-serif font-bold text-dark mb-2","children":"📖 How to Identify Scam Projects in Crypto"}],["$","p",null,{"className":"text-sm","style":{"color":"#555"},"children":"Learn the red flags that separate legitimate projects from rug pulls and Ponzis. Essential reading before you invest."}]]}],["$","div",null,{"style":{"fontSize":24,"marginLeft":12},"children":"→"}]]}]}]}],["$","$Ld",null,{"initialItems":[{"id":"seed-luna-ust","name":"Terra Luna / UST","logo":"🌙","cause_of_death":"collapse","obituary":"Terra was a blockchain ecosystem built around UST, an algorithmic stablecoin designed to maintain its $1 peg through a mint-and-burn mechanism with LUNA. At its peak in April 2022, the ecosystem had $18B in TVL. Anchor Protocol promised 20% APY. This yield was astronomical compared to traditional banking. Investors worldwide trusted that the economic model was sound.","peak_price":"$$119.18","peak_tvl":"$$18B","peak_volume":"—","date_of_death":"May 2022","chain":"Terra","type":"project","category":"collapse","status":"live"},{"id":"seed-ftx-ftt","name":"FTX / FTT","logo":"💱","cause_of_death":"rug","obituary":"FTX was valued at $32B and considered the \"safe\" exchange. Sequoia backed it. SBF testified before Congress. FTX promised proper compliance and smart money backing. Millions of users trusted their coins to FTX.","peak_price":"$$84.18","peak_tvl":"$$32B","peak_volume":"—","date_of_death":"Nov 2022","chain":"Multi-chain","type":"project","category":"rug","status":"live"},{"id":"seed-bitconnect","name":"BitConnect","logo":"🔗","cause_of_death":"ponzi","obituary":"BitConnect promised 1% daily returns through an automated trading bot. It attracted billions in deposits from retail investors worldwide. The marketing was relentless: referral links everywhere, YouTube influencers shilling it, testimonials of people who \"made money.\" BCC tokens soared to $463 in December 2017. The community was cult-like: \"Bitconnect!\" became a meme chant.","peak_price":"$$463","peak_tvl":"$$2.6B","peak_volume":"—","date_of_death":"Jan 2018","chain":"Own chain","type":"project","category":"ponzi","status":"live"},{"id":"seed-squid-game-token","name":"Squid Game Token","logo":"🦑","cause_of_death":"rug","obituary":"Squid Game Token launched riding Netflix's viral success. The team promised a play-to-earn game based on Squid Game. Within days, retail FOMO exploded. The token went from $0.01 to $38. Twitter exploded with \"TO THE MOON\" posts. No one was asking hard questions.","peak_price":"$$2,856","peak_tvl":"N/A","peak_volume":"—","date_of_death":"Nov 2021","chain":"BSC","type":"project","category":"rug","status":"live"},{"id":"seed-safemoon","name":"SafeMoon","logo":"🚀","cause_of_death":"rug","obituary":"SafeMoon launched with a novel tokenomics structure: 10% tax on every transaction. 5% redistributed to holders, 5% locked in the liquidity pool. The pitch was genius: holders who didn't sell earned more tokens. The community exploded. By April 2021, SafeMoon had a $6B market cap. Celebrity endorsements from Jake Paul, Lil Yachty, and Nick Carter amplified the hype.","peak_price":"$$0.000014","peak_tvl":"$$6B","peak_volume":"—","date_of_death":"Oct 2023","chain":"BSC","type":"project","category":"rug","status":"live"},{"id":"seed-iron-finance","name":"Iron Finance","logo":"🪙","cause_of_death":"collapse","obituary":"Iron Finance was a partially-collateralized stablecoin on Polygon. IRON was backed 75% by USDC and 25% by TITAN. Mark Cuban publicly backed the project. Prominent investors poured money in. TITAN reached $64 per coin. Iron Finance hit a $2B TVL.","peak_price":"$$64.04","peak_tvl":"$$2B","peak_volume":"—","date_of_death":"Jun 2021","chain":"Polygon","type":"project","category":"collapse","status":"live"},{"id":"seed-celsius","name":"Celsius Network","logo":"🌡️","cause_of_death":"collapse","obituary":"Celsius Network was a lending platform offering 18% APY on crypto deposits — far above market rate. Users deposited billions into Celsius to earn yield. The marketing emphasized safety and high returns. Celsius even had insurance backing. The growth was explosive.","peak_price":"N/A","peak_tvl":"$$2B+","peak_volume":"—","date_of_death":"Jun 2022","chain":"Multi-chain","type":"project","category":"collapse","status":"live"},{"id":"seed-three-arrows-capital","name":"Three Arrows Capital (3AC)","logo":"📉","cause_of_death":"collapse","obituary":"3AC was a prominent crypto hedge fund founded by Su Zhu and Kyle Davies. The fund managed billions in assets and was known for aggressive leveraged trades. It was seen as sophisticated money. Major lenders trusted 3AC with billions in credit lines.","peak_price":"N/A","peak_tvl":"$$10B+","peak_volume":"—","date_of_death":"Jun 2022","chain":"Multi-chain","type":"project","category":"collapse","status":"live"},{"id":"seed-voyager-digital","name":"Voyager Digital","logo":"🛸","cause_of_death":"collapse","obituary":"Voyager Digital was a crypto lending platform similar to Celsius. It offered yield on deposits and grew quickly. By June 2022, Voyager had $5.8B in customer assets under custody. The company seemed stable and well-managed.","peak_price":"N/A","peak_tvl":"$$5.8B","peak_volume":"—","date_of_death":"Jul 2022","chain":"Multi-chain","type":"project","category":"collapse","status":"live"},{"id":"seed-blockfi","name":"BlockFi","logo":"🏦","cause_of_death":"collapse","obituary":"BlockFi was a crypto lending and trading platform founded by Mike Novogratz and Max Levchin. It offered yield on deposits similar to Celsius. BlockFi was VC-backed and seemed legitimate. By late 2022, BlockFi had hundreds of thousands of users.","peak_price":"N/A","peak_tvl":"$$14B+","peak_volume":"—","date_of_death":"Nov 2022","chain":"Multi-chain","type":"project","category":"collapse","status":"live"},{"id":"seed-luna-classic","name":"Luna Classic (LUNC)","logo":"👻","cause_of_death":"collapse","obituary":"After Luna crashed, the Terra blockchain continued to exist. The community renamed LUNA to LUNC (Luna Classic) in an attempt to rebuild. But the chain had lost all credibility.","peak_price":"$$0.0001","peak_tvl":"$$20B","peak_volume":"—","date_of_death":"May 2022","chain":"Terra Classic","type":"project","category":"collapse","status":"live"},{"id":"seed-ronin-network","name":"Ronin Network","logo":"⚔️","cause_of_death":"exploit","obituary":"Ronin Network was Axie Infinity's sidechain. It had significant TVL and was supposed to be secure. Axie Infinity was one of the biggest gaming projects in crypto.","peak_price":"$$175","peak_tvl":"$$850M","peak_volume":"—","date_of_death":"Mar 2022","chain":"Ronin","type":"project","category":"exploit","status":"live"},{"id":"seed-axie-infinity","name":"Axie Infinity (Post-Collapse)","logo":"🐤","cause_of_death":"collapse","obituary":"Axie Infinity was the leading play-to-earn game in 2021. Players earned SLP tokens by playing. The game had a $3B market cap. At its peak, Axie had millions of active players.","peak_price":"$$33 (AXS)","peak_tvl":"$$3B","peak_volume":"—","date_of_death":"2022","chain":"Multi-chain","type":"project","category":"collapse","status":"live"},{"id":"seed-terra","name":"Terra Classic (LUNC)","logo":"⛓","cause_of_death":"collapse","obituary":"Once the darling of DeFi. Terra Classic technically still exists but is a ghost chain with near-zero activity. A permanent monument to the $40B that disappeared.","peak_price":"$$119 (LUNA)","peak_tvl":"$$20B ecosystem TVL","peak_volume":"$$3B daily","date_of_death":"May 2022","chain":"Terra","type":"chain","category":"collapse","status":"live"},{"id":"seed-ronin","name":"Ronin Network","logo":"⚔️","cause_of_death":"exploit","obituary":"Axie Infinity's sidechain was compromised for $625M — the largest DeFi hack in history. North Korean state hackers compromised 5 of 9 validator nodes through social engineering. The chain recovered but never regained its former TVL or trust.","peak_price":"$$175 (RON)","peak_tvl":"$$850M TVL","peak_volume":"$$600M daily","date_of_death":"Mar 2022","chain":"Ronin","type":"chain","category":"exploit","status":"live"}]}],"$Le"]}]
